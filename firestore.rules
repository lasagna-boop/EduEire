rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedStudentDomain(email) {
      return email.matches('(?i)^[^@\\s]+@dcu\\.ie$')
        || email.matches('(?i)^[^@\\s]+@mumail\\.ie$')
        || email.matches('(?i)^[^@\\s]+@mytudublin\\.ie$')
        || email.matches('(?i)^[^@\\s]+@ncirl\\.ie$')
        || email.matches('(?i)^[^@\\s]+@rcsi\\.ie$')
        || email.matches('(?i)^[^@\\s]+@studentmail\\.ul\\.ie$')
        || email.matches('(?i)^[^@\\s]+@tcd\\.ie$')
        || email.matches('(?i)^[^@\\s]+@ucdconnect\\.ie$')
        || email.matches('(?i)^[^@\\s]+@ucc\\.ie$')
        || email.matches('(?i)^[^@\\s]+@umail\\.ucc\\.ie$')
        || email.matches('(?i)^[^@\\s]+@universityofgalway\\.ie$');
    }

    function hasStudentEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && isAllowedStudentDomain(request.auth.token.email);
    }

    function expectedAccessMode() {
      return hasStudentEmail() ? "full" : "read_only";
    }

    function userWriteAllowedKeys() {
      return [
        'displayName',
        'publicHandle',
        'statusFlashText',
        'statusFlashExpiresAt',
        'profileBio',
        'followingUserIds',
        'subscriptions',
        'lastFlairWeekKey',
        'lastFlairAt',
        'studentEmailConfirmed',
        'accessMode',
        'updatedAt',
        'createdAt'
      ];
    }

    function userPrivilegedKeys() {
      return [
        'role',
        'approvedPostsCount',
        'approvedCommentsCount',
        'rejectedContentCount',
        'pendingReviewCount',
        'cumulativeCommentScore',
        'cumulativeThreadScore',
        'helpfulMarksCount',
        'totalThreadsCount',
        'totalCommentsCount',
        'lastContributionAt',
        'activeDays30d',
        'reportsAgainstCount',
        'confirmedReportsCount',
        'credibilityModelVersion',
        'credibilityScoreCached',
        'credibilityScoreUpdatedAt'
      ];
    }

    function userIdentityFlagsOk(data) {
      return data.studentEmailConfirmed == hasStudentEmail()
        && data.accessMode == expectedAccessMode();
    }

    function userIdentityFlagUpdatesOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['studentEmailConfirmed'])
          || request.resource.data.studentEmailConfirmed == hasStudentEmail())
        && (!changed.hasAny(['accessMode'])
          || request.resource.data.accessMode == expectedAccessMode());
    }

    /** Matches client READ_ONLY_ALLOWED_SECTIONS (Admissions / First Year). */
    function tagsAllowReadOnlyThread(tags) {
      return tags is list
        && tags.hasAny(['Admissions', 'First Year/Transition']);
    }

    function userAccessMode() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return d.keys().hasAny(['accessMode']) ? d.accessMode : '';
    }

    function readOnlyUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userAccessMode() == 'read_only';
    }

    /** Full student email OR read-only account (client limits sections elsewhere). */
    function canCreateThreadContent(data) {
      return hasStudentEmail()
        || (readOnlyUser() && tagsAllowReadOnlyThread(data.tags));
    }

    function threadCreateOk(data) {
      return data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.communityId is string
        && data.communityId.size() >= 1
        && data.communityId.size() <= 64
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 180
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 12000
        && data.tags is list;
    }

    function postCreateOk(data) {
      return data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 12000;
    }

    function threadTagList(threadId) {
      let d = get(/databases/$(database)/documents/threads/$(threadId)).data;
      return d.keys().hasAny(['tags']) && d.tags is list ? d.tags : [];
    }

    function canCreatePostInThread(threadId) {
      return hasStudentEmail()
        || (
          readOnlyUser()
          && exists(/databases/$(database)/documents/threads/$(threadId))
          && tagsAllowReadOnlyThread(threadTagList(threadId))
        );
    }

    function flairCreateOk(data) {
      return data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 80
        && (!data.keys().hasAny(['description'])
          || (data.description is string && data.description.size() <= 300));
    }

    function voteValueOk() {
      return request.resource.data.keys().hasOnly(['vote'])
        && (
          request.resource.data.vote == "up"
          || request.resource.data.vote == "down"
          || request.resource.data.vote == null
        );
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create, update: if request.auth != null && isAdmin();
      allow delete: if false;
    }

    /** Aggregate marketing stats (maintained by Cloud Functions). World-readable. */
    match /public_stats/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    function userFlashStatusTextOk(data) {
      return !data.keys().hasAny(['statusFlashText'])
        || (data.statusFlashText is string && data.statusFlashText.size() <= 160);
    }

    function userProfileBioOk(data) {
      return !data.keys().hasAny(['profileBio'])
        || (data.profileBio is string && data.profileBio.size() <= 500);
    }

    function userPublicHandleOk() {
      let after = request.resource.data;
      return !after.keys().hasAny(['publicHandle'])
        || (
          after.publicHandle is string
          && after.publicHandle.size() >= 2
          && after.publicHandle.size() <= 30
          && after.publicHandle.matches('^[a-z0-9][a-z0-9._-]*$')
          && (
            !resource.exists
            || !resource.data.keys().hasAny(['publicHandle'])
            || after.publicHandle == resource.data.publicHandle
          )
        );
    }

    function userFollowingIdsOk(data) {
      return !data.keys().hasAny(['followingUserIds'])
        || (
          data.followingUserIds is list
          && data.followingUserIds.size() <= 500
        );
    }

    function userSubscriptionsOk(data) {
      return !data.keys().hasAny(['subscriptions'])
        || (
          data.subscriptions is list
          && data.subscriptions.size() <= 200
        );
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(userWriteAllowedKeys())
        && userIdentityFlagsOk(request.resource.data)
        && userFlashStatusTextOk(request.resource.data)
        && userProfileBioOk(request.resource.data)
        && userPublicHandleOk()
        && userFollowingIdsOk(request.resource.data)
        && userSubscriptionsOk(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userWriteAllowedKeys())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userPrivilegedKeys())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        && userIdentityFlagUpdatesOk()
        && userFlashStatusTextOk(request.resource.data)
        && userProfileBioOk(request.resource.data)
        && userPublicHandleOk()
        && userFollowingIdsOk(request.resource.data)
        && userSubscriptionsOk(request.resource.data);
      allow delete: if false;
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if request.auth != null
        && threadCreateOk(request.resource.data)
        && canCreateThreadContent(request.resource.data);
      // Only admins can change moderation fields from clients.
      // Score and activity counters are server-managed via Cloud Functions.
      allow update: if request.auth != null
        && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['moderationStatus', 'moderationMatches']);
      allow delete: if false;

      match /votes/{odineuserId} {
        allow read: if request.auth != null && request.auth.uid == odineuserId;
        allow create, update: if request.auth != null
          && request.auth.uid == odineuserId
          && voteValueOk();
        allow delete: if request.auth != null && request.auth.uid == odineuserId;
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if request.auth != null
          && postCreateOk(request.resource.data)
          && canCreatePostInThread(threadId);
        allow update: if request.auth != null
          && isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['moderationStatus', 'moderationMatches']);
        allow delete: if false;

        match /votes/{odineuserId} {
          allow read: if request.auth != null && request.auth.uid == odineuserId;
          allow create, update: if request.auth != null
            && request.auth.uid == odineuserId
            && voteValueOk();
          allow delete: if request.auth != null && request.auth.uid == odineuserId;
        }
      }
    }

    match /flairs/{flairId} {
      allow read: if true;
      allow create: if hasStudentEmail() && flairCreateOk(request.resource.data);
      // Score and moderation are server/admin managed.
      allow update: if request.auth != null
        && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationStatus']);
      allow delete: if false;

      match /votes/{odineuserId} {
        allow read: if request.auth != null && request.auth.uid == odineuserId;
        allow create, update: if request.auth != null
          && request.auth.uid == odineuserId
          && voteValueOk();
        allow delete: if request.auth != null && request.auth.uid == odineuserId;
      }
    }

    match /moderator_applications/{applicationId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'applicantId',
          'applicantName',
          'applicantEmail',
          'motivation',
          'experience',
          'availability',
          'status',
          'createdAt'
        ])
        && request.resource.data.applicantId is string
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() >= 1
        && request.resource.data.applicantName.size() <= 80
        && request.resource.data.applicantEmail is string
        && request.resource.data.applicantEmail.size() <= 120
        && request.resource.data.motivation is string
        && request.resource.data.motivation.size() >= 20
        && request.resource.data.motivation.size() <= 1200
        && request.resource.data.experience is string
        && request.resource.data.experience.size() <= 1200
        && request.resource.data.availability is string
        && request.resource.data.availability.size() <= 300
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'reviewing', 'accepted', 'rejected'];
      allow delete: if false;
    }

    // Map POIs (imported CSV / edited in console). Client read-only; writes via Console or Admin SDK.
    match /map_points/{pointId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
